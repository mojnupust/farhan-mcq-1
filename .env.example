# =============================================================================
# Farhan MCQ — Frontend Environment Variables
# =============================================================================
# Copy this file to `.env.local` and replace placeholder values.
#
#   cp .env.example .env.local
#
# Next.js loads `.env.local` automatically in development and production builds.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser — never put
# secrets there.
# =============================================================================

# -----------------------------------------------------------------------------
# API connectivity
# -----------------------------------------------------------------------------

# Use mock services instead of the real backend API.
# Set to "false" when the Express API is running.
USE_MOCKS=false

# Public API base path used by the browser HTTP client.
# Development (recommended): same-origin proxy via Next.js rewrites
NEXT_PUBLIC_API_URL=/api

# Backend origin (scheme + host + port only) — used for:
#   - Content-Security-Policy connect-src in middleware
#   - Server-side calls to the Express API (AI key store, broadcast, etc.)
NEXT_PUBLIC_API_ORIGIN=http://localhost:3002

# Target for Next.js dev proxy (next.config.ts rewrites /api/v1/* → backend)
API_PROXY_TARGET=http://localhost:3002

# Production site URL for CORS headers on /api/* routes (optional)
# NEXT_PUBLIC_APP_URL=https://farhanmcq.com

# -----------------------------------------------------------------------------
# Shared secrets (server-side only — never NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# Must match the backend .env values exactly.

# Validates admin-only Next.js API routes and internal backend proxy calls
INTERNAL_API_SECRET=change-me-shared-secret-min-32-characters-long

# Used by admin-guard and broadcast utilities to verify JWTs server-side
# Must match JWT_SECRET in backend/.env
JWT_SECRET=change-me-use-openssl-rand-hex-32-in-production

# -----------------------------------------------------------------------------
# AI provider keys (server-side — Next.js /api/ai/* routes)
# -----------------------------------------------------------------------------
# Keys can also be managed in the admin panel (stored encrypted in the backend).
# Comma-separated lists enable round-robin across multiple keys.

# Google Gemini — question import, routine generation
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEYS=key-one,key-two
# GEMINI_MODEL=gemini-pro-3.1

# Mistral AI
# MISTRAL_API_KEY=your-mistral-api-key
# MISTRAL_API_KEYS=key-one,key-two,key-three
# MISTRAL_MODEL=mistral-large-latest

# Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_API_KEYS=key-one,key-two
# ANTHROPIC_MODEL_OPUS=claude-opus-4-8
# ANTHROPIC_MODEL_SONNET=claude-sonnet-5

# OpenAI
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_KEYS=key-one,key-two
# OPENAI_MODEL=gpt-4o
# OPENAI_MODEL_MINI=gpt-4o-mini

# OmniRoute — self-hosted OpenAI-compatible gateway (optional)
# OMNIROUTE_API_KEY=your-omniroute-key
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_MODEL=auto
